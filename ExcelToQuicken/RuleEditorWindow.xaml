<Window x:Class="BanortePDFToExcel.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category Rule"
        Width="700"
        MinWidth="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Padding="18"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Name" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="1" Text="Priority" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="PriorityBox" Grid.Row="1" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="2" Text="Match field" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <ComboBox x:Name="FieldBox" Grid.Row="2" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="3" Text="Match type" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <ComboBox x:Name="TypeBox" Grid.Row="3" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="4" Text="Match text / pattern" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="MatchBox" Grid.Row="4" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="5" Text="Category" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="CategoryBox" Grid.Row="5" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="6" Text="Optional tag" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="TagBox" Grid.Row="6" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="7" Text="Optional payee" VerticalAlignment="Center" Padding="6,0" Margin="0,4,16,4" />
        <TextBox x:Name="PayeeBox" Grid.Row="7" Grid.Column="1" Margin="0,3,0,3" MinHeight="30" VerticalContentAlignment="Center" ToolTip="Replace the transaction payee/description when this rule matches." />

        <CheckBox x:Name="EnabledBox" Grid.Row="8" Grid.ColumnSpan="2" Content="Enabled" Margin="0,8,0,3" />
        <CheckBox x:Name="StopBox" Grid.Row="9" Grid.ColumnSpan="2" Content="Stop processing after match" Margin="0,3,0,8" IsChecked="True" />

        <TextBlock Grid.Row="10" Text="Sample description" VerticalAlignment="Top" Padding="6,0" Margin="0,7,16,4" />
        <Grid Grid.Row="10" Grid.Column="1" Margin="0,3,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SampleBox" MinHeight="30" VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Content="Test Rule" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,7" Click="Test_Click" />
        </Grid>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,6,6">
            <Button Content="OK" IsDefault="True" MinWidth="88" Padding="18,7" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="10,0,0,0" Padding="14,7" />
        </StackPanel>
    </Grid>
</Window>
