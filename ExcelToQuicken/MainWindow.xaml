<Window x:Class="BanortePDFToExcel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bank2Excel Category Applier" Width="900" Height="650" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#0F172A" Padding="34,22"><StackPanel><TextBlock Text="Bank2Excel Category Applier" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Add your saved transaction categories to a Bank2Excel workbook." Margin="0,7,0,0" Foreground="#CBD5E1" FontSize="14"/></StackPanel></Border>
<TabControl Grid.Row="1" Margin="28,16,28,12"><TabItem Header="Convert Workbook"><Grid Margin="6,12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="DropZone" AllowDrop="True" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Background="White" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="12" Padding="24,20"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="56" Height="56" CornerRadius="10" Background="#DCFCE7" HorizontalAlignment="Center"><TextBlock Text="XLSX" Foreground="#15803D" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Drag and drop your Excel file here" Margin="0,14,0,0" Foreground="#0F172A" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="The original file will not be overwritten." Margin="0,5,0,12" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center"/><Button x:Name="BrowseButton" Content="Browse for Excel file" Click="BrowseButton_Click" MinHeight="44" Background="White" Foreground="#166534" BorderBrush="#16A34A"/></StackPanel></Border>
<Border Grid.Row="1" Margin="0,14,0,0" Padding="14,10" Background="#F1F5F9" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Selected file:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="SelectedFileText" Grid.Column="1" Margin="10,0,0,0" Text="No file selected" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></Border>
<StackPanel Grid.Row="2" Margin="4,12,0,0" Orientation="Horizontal"><CheckBox x:Name="OverwriteCategoriesCheckBox" Content="Overwrite existing categories" Foreground="#334155"/><CheckBox x:Name="CreateQifCheckBox" Margin="24,0,0,0" Content="Create Quicken QIF files" IsChecked="True" Foreground="#334155" Checked="CreateQifCheckBox_Changed" Unchecked="CreateQifCheckBox_Changed"/></StackPanel><ProgressBar x:Name="ConversionProgress" Grid.Row="3" Height="5" Margin="0,12,0,0" IsIndeterminate="True" Foreground="#16A34A" Visibility="Collapsed"/>
<Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Choose an .xlsx file to begin." Foreground="#475569" FontSize="13" TextWrapping="Wrap"/><Button x:Name="OpenOutputButton" Content="Open output folder" Margin="0,8,0,0" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#15803D" Visibility="Collapsed" Click="OpenOutputButton_Click"/></StackPanel><Button x:Name="ConvertButton" Grid.Column="1" Content="Convert workbook" MinWidth="175" MinHeight="44" IsEnabled="False" Click="ConvertButton_Click" Background="#16A34A" Foreground="White" BorderBrush="#15803D"/></Grid></Grid></TabItem>
<TabItem x:Name="QifOptionsTab" Header="Quicken Export"><Grid Margin="6,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Map each Excel worksheet to the exact account name used in Quicken." Foreground="#334155" FontSize="14"/><TextBlock x:Name="QifMappingHintText" Grid.Row="1" Margin="0,6,0,12" Text="Choose a workbook first. Mappings are remembered on this computer." Foreground="#64748B" FontSize="12"/><DataGrid x:Name="QifMappingsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Margin="0,0,0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="Export" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Excel worksheet" Binding="{Binding WorksheetName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Quicken account name" Binding="{Binding QuickenAccountName, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTemplateColumn Header="Type" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3"><CheckBox x:Name="IncludeUncategorizedCheckBox" Content="Include uncategorized transactions in QIF" Foreground="#334155"/><TextBlock Margin="22,4,0,0" Text="Leave this off to stop QIF creation when a transaction still needs a category." Foreground="#64748B" FontSize="12"/></StackPanel></Grid></TabItem>
<TabItem Header="Category Rules"><Grid Margin="6,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBox x:Name="RuleSearchBox" Width="260" Height="30" VerticalContentAlignment="Center" ToolTip="Search name, match text, or category" TextChanged="RuleSearchBox_TextChanged"/><TextBlock Text="  Search rules" VerticalAlignment="Center" Foreground="#64748B"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Import Rules" Click="ImportRules_Click" Margin="4,0" Padding="12,5"/><Button Content="Export Rules" Click="ExportRules_Click" Margin="4,0" Padding="12,5"/><Button Content="Reset Defaults" Click="ResetDefaults_Click" Margin="4,0" Padding="12,5"/></StackPanel></DockPanel><DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" Margin="0,0,0,10"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="42"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="65"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Match" Binding="{Binding MatchText}" Width="*"/><DataGridTextColumn Header="Match type" Binding="{Binding MatchType}" Width="105"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2"><Button Content="Add" Click="AddRule_Click" Margin="3" Padding="14,6"/><Button Content="Edit" Click="EditRule_Click" Margin="3" Padding="14,6"/><Button Content="Duplicate" Click="DuplicateRule_Click" Margin="3" Padding="14,6"/><Button Content="Delete" Click="DeleteRule_Click" Margin="3" Padding="14,6"/><Button Content="Enable/Disable" Click="ToggleRule_Click" Margin="3" Padding="14,6"/><Button Content="Move Up" Click="MoveUp_Click" Margin="3" Padding="14,6"/><Button Content="Move Down" Click="MoveDown_Click" Margin="3" Padding="14,6"/><Button Content="Save" Click="SaveRules_Click" Margin="15,3,3,3" Padding="18,6" Background="#16A34A" Foreground="White"/><Button Content="Cancel" Click="CancelRules_Click" Margin="3" Padding="14,6"/></WrapPanel></Grid></TabItem></TabControl>
<Border Grid.Row="2" Background="#E2E8F0" Padding="34,10"><TextBlock Text="Processing stays on this computer. Supported format: .xlsx" Foreground="#475569" FontSize="12"/></Border></Grid></Window>
